[Unit]
Description=AM Kind fleet: refresh cross-cluster bridge Endpoints from Docker DNS
Documentation=file:///root/am-repos/am-infra-automation/terraform/kind-fleet/scripts/systemd/README.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
Environment=ENV=prod
Environment=HOME=/root
Environment=ASRAX_HOME=/home/am-ops/.asrax
ExecStart=/bin/bash /root/am-repos/am-infra-automation/terraform/kind-fleet/scripts/refresh-cross-cluster-bridges.sh
Nice=10
