# Copy to /data/am-state/obs/secrets/grafana.env on VPS2 (never commit real secrets).
# Grafana uses embedded SQLite — no GF_DATABASE_HOST / Postgres.
# iam-sso Phase 2: Keycloak realm is am-realm (not /realms/am).

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME

# Keycloak OIDC — prod issuer auth.asrax.in; lab auth-dev.asrax.in
GF_AUTH_GENERIC_OAUTH_ENABLED=true
GF_AUTH_GENERIC_OAUTH_NAME=Keycloak
GF_AUTH_GENERIC_OAUTH_CLIENT_ID=grafana
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=CHANGE_ME
GF_AUTH_GENERIC_OAUTH_SCOPES=openid profile email roles
GF_AUTH_GENERIC_OAUTH_AUTH_URL=https://auth.asrax.in/realms/am-realm/protocol/openid-connect/auth
GF_AUTH_GENERIC_OAUTH_TOKEN_URL=https://auth.asrax.in/realms/am-realm/protocol/openid-connect/token
GF_AUTH_GENERIC_OAUTH_API_URL=https://auth.asrax.in/realms/am-realm/protocol/openid-connect/userinfo
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH=contains(roles[*], 'am-admin') && 'Admin' || contains(roles[*], 'am-ops') && 'Editor' || contains(roles[*], 'am-viewer') && 'Viewer' || 'None'
GF_AUTH_DISABLE_LOGIN_FORM=true
